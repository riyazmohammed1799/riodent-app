rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin verified by custom claim admin: true and verified email
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.admin == true
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS collection
    match /users/{userId} {
      // Users can read own profile; Admin can read any profile
      allow read: if isOwner(userId) || isAdmin();

      // Users can create own profile without role escalation; Admin can create/write
      allow create: if isOwner(userId)
                    && !('role' in request.resource.data)
                    || isAdmin();

      // Users can update own profile (cannot set role); Admin can update
      allow update: if isOwner(userId)
                    && !('role' in request.resource.data)
                    || isAdmin();

      // In-app account deletion
      allow delete: if isOwner(userId) || isAdmin();
    }

    // TECHNICIAN REQUESTS collection
    match /technicianRequests/{requestId} {
      // Owner dentist can read; Admin can read all
      allow read: if isAuthenticated() && (resource.data.dentistId == request.auth.uid || isAdmin());

      // Create by Doctor: dentistId == uid, status NEW, future slotStart, valid description, no amountPaid
      allow create: if isAuthenticated()
                    && request.resource.data.dentistId == request.auth.uid
                    && request.resource.data.status == 'NEW'
                    && request.resource.data.slotStart > request.time
                    && request.resource.data.issueDescription.size() >= 1
                    && request.resource.data.issueDescription.size() <= 500
                    && !('amountPaid' in request.resource.data)
                    || isAdmin();

      // Status updates enforced server-side
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.dentistId == request.auth.uid
          && request.resource.data.dentistId == request.auth.uid
          && (
            // Doctor Cancellation: from NEW or ASSIGNED to CANCELLED with reason
            (
              resource.data.status in ['NEW', 'ASSIGNED']
              && request.resource.data.status == 'CANCELLED'
              && request.resource.data.cancelledBy == 'dentist'
              && request.resource.data.reasonText.size() >= 1
            )
            ||
            // Doctor Completion: from ASSIGNED or IN_PROGRESS to COMPLETED with whole rupee amountPaid >= 0
            (
              resource.data.status in ['ASSIGNED', 'IN_PROGRESS']
              && request.resource.data.status == 'COMPLETED'
              && request.resource.data.completedBy == 'dentist'
              && request.resource.data.amountPaid >= 0
              && request.resource.data.amountPaid <= 100000
            )
            ||
            // Doctor Edit: fix wrong time or wrong issue while status is NEW or ASSIGNED
            (
              resource.data.status in ['NEW', 'ASSIGNED']
              && request.resource.data.status == resource.data.status
              && request.resource.data.dentistId == resource.data.dentistId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'issueCode', 'issueLabel', 'issueDescription', 'slotDate', 'slotKey', 'slotStart', 'address', 'updatedAt'
              ])
            )
          )
        )
      );

      allow delete: if false;

      // Subcollection: events (audit history)
      match /events/{eventId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/technicianRequests/$(requestId)).data.dentistId == request.auth.uid
          || isAdmin()
        );
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/technicianRequests/$(requestId)).data.dentistId == request.auth.uid
          || isAdmin()
        );
        allow update, delete: if false;
      }

      // Subcollection: internal notes (Admin only; doctors denied)
      match /internal/{allPaths=**} {
        allow read, write: if isAdmin();
      }
    }

    // TECHNICIANS collection (Admin only)
    match /technicians/{technicianId} {
      allow read, write: if isAdmin();
    }

    // APP SETTINGS collection
    match /appSettings/{document} {
      // Authenticated users can read booking config
      allow read: if isAuthenticated();
      // Only admin can write settings
      allow write: if isAdmin();
    }
  }
}
