{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "equip-services-dev",
          "appId": "1:1085269643387:android:57beff18a7a651941ad2de",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "equip-services-dev",
          "configurations": {
            "android": "1:1085269643387:android:57beff18a7a651941ad2de",
            "web": "1:1085269643387:web:e518f7475e3abd791ad2de"
          }
        }
      }
    }
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
